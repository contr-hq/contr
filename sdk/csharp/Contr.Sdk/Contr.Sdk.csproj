<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Generated/Version.props" />

  <PropertyGroup>
    <PackageId>Contr.Sdk</PackageId>
    <RootNamespace>Contr.Sdk</RootNamespace>
    <Description>Client SDK for the Contr daemon API.</Description>
    <Authors>contr-hq</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/contr-hq/contr</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.StatusProto" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/**/*.proto" ProtoRoot="Protos" GrpcServices="Client" />
  </ItemGroup>

</Project>
